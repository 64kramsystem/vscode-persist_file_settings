{
  "name": "persist-file-settings",
  "displayName": "Persist Per-File Settings",
  "description": "Remembers language mode and word wrap on a per-file basis and restores them when the file is reopened.",
  "version": "0.0.1",
  "publisher": "saverio",
  "engines": { "vscode": "^1.75.0" },
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "persistFileSettings.toggleWordWrap", "title": "Persist File Settings: Toggle Word Wrap" },
      { "command": "persistFileSettings.clearForFile", "title": "Persist File Settings: Clear for This File" },
      { "command": "persistFileSettings.clearAll", "title": "Persist File Settings: Clear All Entries" }
    ],
    "keybindings": [
      { "command": "persistFileSettings.toggleWordWrap", "key": "alt+w", "when": "editorTextFocus" }
    ],
    "configuration": {
      "title": "Persist Per-File Settings",
      "properties": {
        "persistFileSettings.cleanupAfterDays": {
          "type": "number",
          "default": 14,
          "minimum": 0,
          "description": "Discard persisted settings for files not opened within this many days. Cleanup runs once at VS Code startup. Set to 0 to disable cleanup."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "test": "tsx --test src/test/*.test.ts",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.24.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
